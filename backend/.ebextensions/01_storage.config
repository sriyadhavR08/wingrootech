commands:
  01_create_media_dirs:
    command: "mkdir -p /var/app_media/college_ids /var/app_media/selfies /var/app_media/certificates && chown -R webapp:webapp /var/app_media && chmod -R 775 /var/app_media"
    ignoreErrors: true
  02_sync_media_from_s3:
    command: |
      BUCKET="wingroo-23243253453"
      if [ -f /opt/elasticbeanstalk/bin/get-config ]; then
        ENV_BUCKET=$(/opt/elasticbeanstalk/bin/get-config environment -k S3_MEDIA_BUCKET 2>/dev/null || /opt/elasticbeanstalk/bin/get-config environment -k SSL_BUCKET_NAME 2>/dev/null || true)
        if [ -n "$ENV_BUCKET" ]; then
          BUCKET="$ENV_BUCKET"
        fi
      fi
      echo "Syncing persistent media from s3://$BUCKET/media/ ..."
      aws s3 sync s3://$BUCKET/media/ /var/app_media/ || true
      chown -R webapp:webapp /var/app_media || true
    ignoreErrors: true

