Resources:
  sslSecurityGroupIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: {"Fn::GetAtt": ["AWSEBSecurityGroup", "GroupId"]}
      IpProtocol: tcp
      ToPort: 443
      FromPort: 443
      CidrIp: 0.0.0.0/0

commands:
  01_fetch_and_setup_ssl:
    command: |
      mkdir -p /etc/letsencrypt/live/backend.wingrootechnologies.com
      
      BUCKET="wingroo-23243253453"
      if [ -f /opt/elasticbeanstalk/bin/get-config ]; then
        ENV_BUCKET=$(/opt/elasticbeanstalk/bin/get-config environment -k SSL_BUCKET_NAME 2>/dev/null || true)
        if [ -n "$ENV_BUCKET" ]; then
          BUCKET="$ENV_BUCKET"
        fi
      fi

      echo "Syncing SSL certificates from s3://$BUCKET ..."

      # 1. Try downloading from s3://$BUCKET/ssl/
      if aws s3 cp s3://$BUCKET/ssl/fullchain.pem /etc/letsencrypt/live/backend.wingrootechnologies.com/fullchain.pem; then
        echo "Downloaded fullchain.pem from s3://$BUCKET/ssl/"
        aws s3 cp s3://$BUCKET/ssl/privkey.pem /etc/letsencrypt/live/backend.wingrootechnologies.com/privkey.pem || true
      # 2. Or try root of bucket s3://$BUCKET/
      elif aws s3 cp s3://$BUCKET/fullchain.pem /etc/letsencrypt/live/backend.wingrootechnologies.com/fullchain.pem; then
        echo "Downloaded fullchain.pem from s3://$BUCKET/"
        aws s3 cp s3://$BUCKET/privkey.pem /etc/letsencrypt/live/backend.wingrootechnologies.com/privkey.pem || true
      fi

      # 3. Fallback dummy cert if S3 upload has not been done yet, ensuring Nginx won't crash
      if [ ! -s /etc/letsencrypt/live/backend.wingrootechnologies.com/fullchain.pem ] || [ ! -s /etc/letsencrypt/live/backend.wingrootechnologies.com/privkey.pem ]; then
        echo "Warning: Real SSL certificate not present yet. Generating temporary self-signed cert for Nginx boot..."
        openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
          -keyout /etc/letsencrypt/live/backend.wingrootechnologies.com/privkey.pem \
          -out /etc/letsencrypt/live/backend.wingrootechnologies.com/fullchain.pem \
          -subj "/CN=backend.wingrootechnologies.com"
      fi

      chmod 600 /etc/letsencrypt/live/backend.wingrootechnologies.com/privkey.pem || true
      chmod 644 /etc/letsencrypt/live/backend.wingrootechnologies.com/fullchain.pem || true
    ignoreErrors: false
