# ==============================================================================
# Wingroo Technologies - Backend Environment Configuration (.env)
# ==============================================================================

# Server Port
PORT=5000

# Secret Key for Sessions / Security tokens
SECRET_KEY=wingroo-technologies-secret-key-prod-2026

# MySQL Database Configuration
# Local: localhost | AWS Lightsail / EC2: localhost or your RDS endpoint
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=wingrootech_db

# Allowed Frontend Origins for CORS (use * or comma-separated domains)
# Example for production: https://wingrootechnologies.com,https://www.wingrootechnologies.com
CORS_ORIGINS=*
